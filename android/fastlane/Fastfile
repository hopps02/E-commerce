default_platform(:android)

PLAY_KEY_PATH = "play_key.json"

platform :android do
  before_all do
    if ENV["PLAY_STORE_JSON_KEY"].to_s.empty?
      UI.user_error!("PLAY_STORE_JSON_KEY env var is not set. " \
                     "Add the Google Play service-account JSON as a GitHub secret " \
                     "and expose it to this job.")
    end
    File.write(PLAY_KEY_PATH, ENV["PLAY_STORE_JSON_KEY"])
  end

  after_all do
    File.delete(PLAY_KEY_PATH) if File.exist?(PLAY_KEY_PATH)
  end

  error do
    File.delete(PLAY_KEY_PATH) if File.exist?(PLAY_KEY_PATH)
  end

  desc "Validate that the service account can talk to Play"
  lane :validate do
    validate_play_store_json_key(json_key: PLAY_KEY_PATH)
  end

  desc "Upload the release AAB to the internal testing track"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key: PLAY_KEY_PATH,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"
    )
  end

  desc "Promote the latest internal build to production"
  lane :promote_to_production do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      json_key: PLAY_KEY_PATH,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Default release lane used by CI — uploads the AAB to the internal track"
  lane :release do
    internal
  end
end
